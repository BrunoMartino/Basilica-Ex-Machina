{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}",
			"!**/node_modules",
			"!**/vendor",
			"!**/dist",
			"!**/build",
			"!**/coverage",
			"!**/.quality"
		]
	},
	"formatter": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "on" } }
	}
}
